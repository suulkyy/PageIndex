# PageIndex .env template — copy to .env and fill in <VLLM_HOST> with your
# remote vLLM IP/hostname. Path note: this file is named env.example (no
# leading dot) on purpose — .gitignore globs .env*, so a dot-prefixed name
# would be ignored.
#
# Tuned for a remote vLLM serving Qwen3.6-27B-AWQ-INT4 with:
#   vllm serve cyankiwi/Qwen3.6-27B-AWQ-INT4 \
#     --tensor-parallel-size 2 --dtype float16 \
#     --max-model-len 65536 --max-num-seqs 8 --max-num-batched-tokens 8192 \
#     --enable-chunked-prefill --enable-prefix-caching \
#     --gpu-memory-utilization 0.92 \
#     --enable-auto-tool-choice --tool-call-parser qwen3_coder \
#     --reasoning-parser qwen3 --trust-remote-code \
#     --host 0.0.0.0 --port 8000 --served-model-name rag-llm
#
# No --quantization flag: this build is packaged as compressed-tensors W4A16,
# not legacy AWQ. vLLM auto-detects from config.json and picks the Marlin INT4
# kernel on Turing. Passing --quantization awq_marlin trips a mismatch check
# (model config declares quant_method=compressed-tensors).
#
# Qwen3.6 has 262k native context — no YARN / --hf-overrides needed at 65536.
# Pass --model hosted_vllm/rag-llm (tree-build) or --model rag-llm (retrieve).

# ─── Tree-build (run_pageindex.py / run_pageindex_verbose.py) ────────────────
VLLM_API_BASE=http://<VLLM_HOST>:8000/v1
VLLM_TIMEOUT=3600
PAGEINDEX_LLM_CONCURRENCY=8                  # match remote --max-num-seqs 8 to avoid KV preemption
VLLM_MAX_TOKENS=1024
VLLM_MAX_MODEL_LEN=65536
VLLM_CTX_MARGIN=1024
# VLLM_ENABLE_THINKING=true   # leave off — tree-build is JSON-only; thinking inflates wall-clock 2-4x with no quality gain

# ─── Retrieval (retrieve_pageindex.py) ───────────────────────────────────────
# Tool-loop turns are forced non-thinking (qwen3 reasoning-parser routes tool
# intent into `reasoning`, breaking tool calls). Final-answer refinement runs
# as a separate vLLM call with thinking enabled when
# PAGEINDEX_RETRIEVE_ENABLE_THINKING=true.
VLLM_BASE_URL=http://<VLLM_HOST>:8000/v1     # retrieval reads VLLM_BASE_URL (with /v1), not VLLM_API_BASE
VLLM_API_KEY=EMPTY                           # AsyncOpenAI requires non-empty; vLLM ignores value

PAGEINDEX_AGENT_MAX_TURNS=20                 # caps runaway loops; books rarely need >15 turns

# Bounded tool-output sizes — chosen to keep the rolling agent history well
# under the 65k context budget even on book-scale docs. The earlier
# 30,721-token overflow on the annual-report PDF was directly caused by
# uncapped structure summaries; these defaults prevent recurrence.
PAGEINDEX_NODE_TEXT_MAX_CHARS=12000
PAGEINDEX_STRUCTURE_SUMMARY_MAX_CHARS=120
PAGEINDEX_RETRIEVE_THINKING_EVIDENCE_MAX_CHARS=20000
PAGEINDEX_TOOL_LOG_MAX_CHARS=4000

# ─── Default profile: throughput, no thinking on final answer ────────────────
# Flip both to enable CoT-refined answers (+5–15 s/query, biggest quality lever):
#   PAGEINDEX_RETRIEVE_ENABLE_THINKING=true
#   PAGEINDEX_AGENT_MAX_TOKENS=8192
PAGEINDEX_RETRIEVE_ENABLE_THINKING=false
PAGEINDEX_AGENT_MAX_TOKENS=2048

# ─── Optional: hosted OpenAI / other LiteLLM providers ───────────────────────
# Required only if you swap --model to a non-vLLM backend (e.g. openai/gpt-5,
# anthropic/claude-sonnet-4-6). vLLM workloads above ignore these.
# OPENAI_API_KEY=
# CHATGPT_API_KEY=                            # alias for OPENAI_API_KEY
